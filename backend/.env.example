# ==============================================================================
# SaaS Learning & Exit Exam Platform - Backend Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8081","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# Supabase Cloud Database Connection (Project: sbvyjbipchglzmttkowy, Region: eu-west-1)
# ------------------------------------------------------------------------------
# DATABASE_URL: Transaction Pooler (Port 6543) for asyncpg runtime queries.
# Note: statement_cache_size=0 must be configured on asyncpg engine for PgBouncer compatibility.
DATABASE_URL=postgresql+asyncpg://postgres.sbvyjbipchglzmttkowy:[YOUR-DB-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# DIRECT_URL: Session Pooler / Direct Connection (Port 5432) for running migrations and DDL.
DIRECT_URL=postgresql://postgres.sbvyjbipchglzmttkowy:[YOUR-DB-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# Supabase API & Service Credentials
# ------------------------------------------------------------------------------
SUPABASE_URL=https://sbvyjbipchglzmttkowy.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
# Backend-only Service Role Secret (Never expose to client apps)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=change_me_to_a_secure_random_64_char_hex_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------------------------------------------------------------
# Content Storage (ADR-009)
# ------------------------------------------------------------------------------
# Options: 'local' (development disk) or 'supabase' (Supabase S3-compatible Storage)
STORAGE_DRIVER=local
STORAGE_BUCKET=course-packages
LOCAL_STORAGE_PATH=../dev_storage/course-packages
